{
  "name": "complytrack-desktop",
  "version": "1.0.0",
  "description": "ComplyTrack Desktop App",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "pack": "electron-builder --dir",
    "postinstall": "cd ../server && npm ci --omit=dev && cd ../client && npm ci && npm run build"
  },
  "dependencies": {
    "electron-log": "^5.1.2",
    "electron-updater": "^6.1.7",
    "wait-on": "^7.2.0"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.3"
  },
  "build": {
    "appId": "com.complytrack.desktop",
    "productName": "ComplyTrack",
    "copyright": "Copyright © 2024 ComplyTrack",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "src/**/*",
      "package.json",
      "../server/**/*",
      "../client/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../server",
        "to": "server",
        "filter": [
          "**/*",
          "!node_modules/.cache/**",
          "!**/*.log",
          "!.git/**",
          "!uploads/**",
          "!reports/**",
          "!notices/**",
          "!.env*",
          "!Dockerfile",
          "!tests/**"
        ]
      },
      {
        "from": "../client/dist",
        "to": "client/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ComplyTrack",
      "uninstallDisplayName": "ComplyTrack",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    },
    "publish": null,
    "forceCodeSigning": false
  }
}
