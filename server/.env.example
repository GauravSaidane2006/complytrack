NODE_ENV=development
PORT=5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/complytrack?retryWrites=true&w=majority
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@complytrack.in

CLIENT_URL=http://localhost:5173
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Main Server (central update & license server)
MAIN_SERVER_URL=http://localhost:5100
COMPLYTRACK_API_KEY=
MAIN_SERVER_CHECK_INTERVAL=15000
MAIN_SERVER_HEARTBEAT_INTERVAL=30000
MAIN_SERVER_REQUEST_TIMEOUT=5000
