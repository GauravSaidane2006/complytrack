NODE_ENV=production
PORT=5173
MONGODB_URI=mongodb://admin:complytrack_secure_2024@mongo:27017/complytrack?authSource=admin
JWT_SECRET=change-this-to-a-strong-random-secret-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@complytrack.in

CLIENT_URL=http://localhost
CLIENT_URL_NETWORK=http://localhost
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# Main Server (central update & license server) - overridden by docker-compose env
MAIN_SERVER_URL=http://main-server:5100
COMPLYTRACK_API_KEY=
MAIN_SERVER_CHECK_INTERVAL=15000
MAIN_SERVER_HEARTBEAT_INTERVAL=30000
MAIN_SERVER_REQUEST_TIMEOUT=5000
