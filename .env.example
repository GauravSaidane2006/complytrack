MONGODB_URI=mongodb://mongo:27017/complytrack
JWT_SECRET=replace-with-a-long-random-string
CLIENT_URL=http://your-domain.com
PORT=5000
NODE_ENV=production

# Main server (optional license/heartbeat)
MAIN_SERVER_URL=http://localhost:5100
COMPLYTRACK_API_KEY=replace-with-your-api-key
MAIN_SERVER_CHECK_INTERVAL=30000
MAIN_SERVER_HEARTBEAT_INTERVAL=60000
MAIN_SERVER_REQUEST_TIMEOUT=10000
